# ─────────────────────────────────────────────────────────────
# cang-jie .gitignore
# 原则：只版本化「源码/脚本/文档/配置/小数据」。产物 + GB 级大资源一律排除。
# 写法心法：类型 glob 优先（一条=一类，自文档）；大二进制宁宽勿窄
#          （漏进历史代价高）；要留例外用「宽忽略 + ! 白名单」。
# ─────────────────────────────────────────────────────────────

# ── Python ──（无中间斜杠即匹配任意层级，不必再写 **/）
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.python-version

# ── Rust ──
target/

# ── C/C++ 产物 ──
*.o
*.a
**/build/
# 编译产物/第三方库一律排除。注意：行内 # 不是 gitignore 注释，注释必须独占一行，
# 否则整条 pattern 连注释文字被吞、规则失效（2026-08-24 修：此前 *.so 一直没生效）。
*.so
*.so.*
# 例外：出货载荷——cangjie-langhook.so 是 install.sh 直接拷的预编译 xovi 扩展，故意 track。
!chinese-ime/langhook/cangjie-langhook.so

# ── 缓存 ──
.cache/
*.qmlc

# ── 部署产物 ──
**/deploy/dist/
# highlights_to_notebook.py 的默认输出目录（生成的 .rm/.content/.metadata 三件套，
# 无代码当夹具读，纯运行产物）。注意：highlights/blank_highlight_page.rm 是输入模板，不在此列。
reading/notegen/

# ─────────────────────────────────────────────────────────────
# 大资源：git 不管，留工作区。需要时按 README/PROVENANCE 重新获取。
# 要版本化其中某类，删对应行（并考虑 git-lfs）。
# ─────────────────────────────────────────────────────────────

# 固件镜像 / 设备二进制 / 反编译工程
rmfw/extracted
rmfw/out/
rmfw/*.bin
ghidra-project*/*.rep/
# Ghidra GUI 打开工程时生成的运行期锁文件，关闭/换机器后可能残留或重生成，不入库
ghidra-project*/*.lock
# Ghidra headless 运行产物（decompile/disasm/dump/find*/import 的 .log），可重生成，不入库
ghidra-project*/*.log
# defw/（3.28.0.172 逆向工程，原名 ghidra-project-328，2026-09-10 改名两次到 defw）同样三条——
# `ghidra-project*` 通配符改名后不再匹配，不是覆盖旧规则，是新加一组，`ghidra-project/`（.169）不受影响。
defw/*.rep/
defw/*.lock
defw/*.log

# 词典（源 .dict.yaml 与派生大 txt；递归匹配子目录）
chinese-ime/pinyin-engine/data/**/*.dict.yaml
chinese-ime/pinyin-engine/data/essay-zh-hans.txt
chinese-ime/pinyin-engine/data/english/frequency_dictionary_*.txt

# 大字体（第三方，可重新下载）
chinese-ime/fonts/**/*.ttf
shelf/koreader/profile/vendor-fonts/*.ttf
shelf/koreader/profile/vendor-fonts/*.otf
chinese-ime/fonts/**/*.otf

# 媒体：宽忽略 assets 下所有，白名单留 logo + 顶层 README 打赏二维码（心法③）
assets/*
!assets/logo.png
!assets/sponsor-wechat.jpg
!assets/sponsor-alipay.jpg

# ── OS / 编辑器 / 解压垃圾 ──
.DS_Store
__MACOSX/
._*
*.swp
*~
*.bak
*.orig

# 字体压缩包（解压后用目录里的文件，zip 本身不入库）
chinese-ime/fonts/**/*.zip

# ── 词典数据（生词本查词）：版权红线 ──
# 牛津/现汉是用户正版商业词典 → MOBI 原文件与派生 TSV 只个人自用、绝不入库/分发。
# 仓库只留不含词典内容的构建脚本 knowledge/pkm/tools/build_dict.py。（心法②：大二进制+版权数据宁宽勿窄。）
*.mobi
knowledge/pkm/tools/dict-build/
# 生词本词典部署文件（en/zh.tsv）。注意不用 *.tsv 全局忽略（别的功能如 snippets.tsv 要留）。
**/dict/en.tsv
**/dict/zh.tsv

# 休眠壁纸小工具：个人照片/运行期文件不入库（设备 /home/root/wallpaper 下才有）。
# 仓库只留工具脚本 + 透明图 blank776.png，用户自备的壁纸不进仓库。
misc/wallpaper/1.png
misc/wallpaper/2.png
misc/wallpaper/current.png
misc/wallpaper/state
misc/wallpaper/pool/

# 全项目安装包产物（大 tarball，不入库）
/dist/

# packaging/install-all.sh --force 追加的"未验证固件哈希"（本机文件，不入 git）
packaging/firmware-allowlist.local.txt
